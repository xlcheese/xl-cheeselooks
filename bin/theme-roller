#!/usr/bin/env python3
"""Theme Roller, from a source checkout.

    theme-roller                 opens the app
    theme-roller apply …         the command line (apply, revert, presets, watch…)
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
if len(sys.argv) > 1:
    from cheeselooks.cli import main  # noqa: E402
else:
    from cheeselooks.app import main  # noqa: E402

sys.exit(main())
