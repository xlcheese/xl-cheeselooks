On-Screen Keyboard (<= Cinnamon 6.4)
*/
#keyboard {
  background-color: {{menu.text}};
  border-width: 0;
  border-top-width: 1px;
  border-color: {{alpha(menu.text, 0.4)}}; }

.keyboard-layout {
  spacing: 10px;
  padding: 10px; }

.keyboard-row {
  spacing: 15px; }

.keyboard-key {
  min-height: 2em;
  min-width: 2em;
  font-size: 1.4em;
  font-weight: bold;
  border-radius: {{menu.r}}px;
  box-shadow: none;
  color: {{mix(menu.menu_bg, menu.text, 0.214)}};
  border: 1px solid {{mix(menu.menu_bg, menu.text, 0.273)}};
  background-color: {{alpha(mix(menu.menu_bg, menu.text, 0.701), 0.4)}}; }
  .keyboard-key:hover {
    color: {{mix(menu.menu_bg, menu.text, 0.214)}};
    border: 1px solid {{alpha(menu.text, 0.4)}};
    background-color: {{alpha(mix(menu.menu_bg, menu.text, 0.604), 0.5)}}; }
  .keyboard-key:active, .keyboard-key:checked {
    color: {{menu.accent_fg}};
    border: 1px solid {{menu.accent}};
    background-color: {{menu.accent}}; }
  .keyboard-key:grayed {
    color: {{mix(menu.menu_bg, menu.text, 0.765)}};
    border: 1px solid {{alpha(menu.text, 0.4)}};
    background-color: {{alpha(mix(menu.menu_bg, menu.text, 0.701), 0.25)}}; }

.keyboard-subkeys {
  color: {{mix(menu.menu_bg, menu.text, 0.214)}};
  padding: 5px;
  -arrow-border-radius: {{menu.r}}px;
  -arrow-background-color: {{menu.text}};
  -arrow-border-width: 1px;
  -arrow-border-color: {{alpha(menu.text, 0.4)}};
  -arrow-base: 20px;
  -arrow-rise: 10px;
  -boxpointer-gap: 5px; }

