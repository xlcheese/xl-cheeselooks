    border: 1px solid {{menu.accent}};
    box-shadow: inset 0 2px 4px {{alpha(mix(menu.menu_bg, menu.text, 0.299), 0.05)}}; }
  .sound-button:active, .notification-button:active, .notification-icon-button:active, .popup-menu #notification .notification-button:active, .popup-menu #notification .notification-icon-button:active {
    color: {{menu.accent_fg}};
