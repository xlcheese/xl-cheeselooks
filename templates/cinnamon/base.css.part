  .media-keys-osd StLabel:rtl {
    margin-left: 6px; }
  .media-keys-osd .level {
    min-width: 160px;
    -barlevel-height: 6px;
    -barlevel-background-color: {{mix(menu.menu_bg, menu.text, 0.123)}};
    -barlevel-active-background-color: {{menu.text}};
    -barlevel-amplify-color: #F27835;
    -barlevel-amplify-separator-width: 3px; }
    .media-keys-osd .level:ltr {
      margin-right: 6px; }
    .media-keys-osd .level:rtl {
      margin-left: 6px; }
  .media-keys-osd .level-bar {
    border-radius: 20px;
    background-color: {{menu.text}}; }

.info-osd {
  font-size: 1.2em;
  font-weight: 700;
  text-align: center; }

.workspace-switch-osd {
  min-width: 140px;
  margin-bottom: 1em;
  border-radius: 20px;
  font-weight: bold;
  padding: 12px 36px 0 36px; }
  .workspace-switch-osd-indicator-box {
    spacing: 12px; }
  .workspace-switch-osd-indicator {
    background-color: {{alpha(menu.text, 0.5)}};
    padding: 3px;
    margin: 15px;
    border-radius: 36px; }
    .workspace-switch-osd-indicator:active {
      background-color: {{menu.accent}};
      padding: 6px;
      margin: 12px; }

.monitor-label {
  border-radius: 0;
  color: {{darker(menu.text, 1)}};
  padding: 12px;
  text-align: center; }

.resize-popup {
  color: {{menu.text}};
  background-color: {{mix(menu.menu_bg, menu.base, 0.05)}};
  border-radius: {{menu.r2}}px;
  padding: 12px; }

.hover-click-dialog {
  padding: 6px;
  border-radius: 12px; }
  .hover-click-dialog .dialog-content-box {
    margin: 0;
    spacing: 0;
    max-width: auto; }

.hover-click-header {
  height: 20px; }

.hover-click-box,
.hover-click-actions {
  spacing: 4px; }

.hover-click-button {
  background-color: transparent;
  border-radius: {{menu.r2}}px;
  padding: 6px; }
  .hover-click-button:checked {
    border: 1px solid {{menu.accent}};
    color: {{menu.text}};
    background-color: {{menu.accent}}; }
  .hover-click-button:checked:hover {
    border: 1px solid {{menu.accent}};
    color: {{menu.text}};
    background-color: {{menu.accent_press}}; }

.hover-click-button-box {
  spacing: 4px; }

.hover-click-button-label {
  text-align: center; }

.hover-click-separator {
  background-color: {{mix(menu.menu_bg, menu.text, 0.273)}}; }

.hover-click-box.vertical .hover-click-separator {
  height: 1px;
  margin: 4px 0; }

.hover-click-box.horizontal .hover-click-separator {
  width: 1px;
  margin: 0 4px; }

.hover-click-lock-button {
  background-color: transparent;
  border-radius: {{menu.r2}}px;
  padding: 6px; }

/*
On-Screen Keyboard (>= Cinnamon 6.6)
*/
#virtual-keyboard {
  background-color: {{mix(menu.menu_bg, menu.base, 0.4)}};
  box-shadow: inset 0 1px 0 0 {{mix(menu.menu_bg, menu.text, 0.273)}}; }

.vkeyboard-key-container {
  padding: 4px;
  spacing: 4px; }

.vkeyboard-key {
  color: {{menu.text}};
  background-color: {{mix(menu.menu_bg, menu.text, 0.299)}};
  border: 1px solid {{mix(menu.menu_bg, menu.text, 0.273)}};
  box-shadow: inset 0 2px 4px {{alpha(mix(menu.menu_bg, menu.text, 0.299), 0.05)}};
  font-size: 1.364em;
  border-width: 1px;
  border-style: solid;
  border-radius: {{menu.r2}}px;
  background-color: {{mix(menu.menu_bg, menu.text, 0.123)}}; }
  .vkeyboard-key:focus {
    color: {{menu.text}};
    background-color: {{mix(menu.menu_bg, menu.text, 0.299)}};
    border: 1px solid {{menu.accent}};
    box-shadow: inset 0 2px 4px {{alpha(mix(menu.menu_bg, menu.text, 0.299), 0.05)}}; }
  .vkeyboard-key:hover, .vkeyboard-key:checked {
    color: {{menu.text}};
    background-color: {{mix(menu.menu_bg, menu.text, 0.235)}};
    border: 1px solid {{mix(menu.menu_bg, menu.text, 0.273)}};
    box-shadow: inset 0 2px 4px {{alpha(mix(menu.menu_bg, menu.text, 0.235), 0.05)}}; }
  .vkeyboard-key:active {
    color: {{menu.accent_fg}};
    background-color: {{menu.accent}};
    border: 1px solid {{menu.accent}};
    box-shadow: inset 0 2px 4px {{menu.accent}}; }
  .vkeyboard-key.shift-key-uppercase {
    background-color: {{mix(menu.menu_bg, menu.text, 0.412)}}; }
  .vkeyboard-key.enter-key {
    border-color: {{menu.accent}};
    background-color: {{mix(menu.menu_bg, menu.text, 0.219)}};
    border-width: 3px; }
  .vkeyboard-key.shift-key-lowercase, .vkeyboard-key.escape-key, .vkeyboard-key.hide-key, .vkeyboard-key.non-alpha-key {
    background-color: {{mix(menu.menu_bg, menu.text, 0.219)}}; }
    .vkeyboard-key.shift-key-lowercase:focus, .vkeyboard-key.escape-key:focus, .vkeyboard-key.hide-key:focus, .vkeyboard-key.non-alpha-key:focus {
      color: {{menu.text}};
      background-color: {{mix(menu.menu_bg, menu.text, 0.299)}};
      border: 1px solid {{menu.accent}};
      box-shadow: inset 0 2px 4px {{alpha(mix(menu.menu_bg, menu.text, 0.299), 0.05)}}; }
    .vkeyboard-key.shift-key-lowercase:hover, .vkeyboard-key.shift-key-lowercase:checked, .vkeyboard-key.escape-key:hover, .vkeyboard-key.escape-key:checked, .vkeyboard-key.hide-key:hover, .vkeyboard-key.hide-key:checked, .vkeyboard-key.non-alpha-key:hover, .vkeyboard-key.non-alpha-key:checked {
      color: {{menu.text}};
      background-color: {{mix(menu.menu_bg, menu.text, 0.235)}};
      border: 1px solid {{mix(menu.menu_bg, menu.text, 0.273)}};
      box-shadow: inset 0 2px 4px {{alpha(mix(menu.menu_bg, menu.text, 0.235), 0.05)}}; }
    .vkeyboard-key.shift-key-lowercase:active, .vkeyboard-key.escape-key:active, .vkeyboard-key.hide-key:active, .vkeyboard-key.non-alpha-key:active {
      color: {{menu.accent_fg}};
      background-color: {{menu.accent}};
      border: 1px solid {{menu.accent}};
      box-shadow: inset 0 2px 4px {{menu.accent}}; }
  .vkeyboard-key.modifier-key {
    background-color: {{mix(menu.menu_bg, menu.text, 0.219)}}; }
    .vkeyboard-key.modifier-key:hover, .vkeyboard-key.modifier-key:checked {
      color: {{menu.text}};
      background-color: {{mix(menu.menu_bg, menu.text, 0.235)}};
      border: 1px solid {{mix(menu.menu_bg, menu.text, 0.273)}};
      box-shadow: inset 0 2px 4px {{alpha(mix(menu.menu_bg, menu.text, 0.235), 0.05)}}; }
    .vkeyboard-key.modifier-key:latched {
      background-color: {{mix(menu.menu_bg, menu.text, 0.412)}}; }
  .vkeyboard-key StIcon {
    icon-size: 1.125em; }

.vkeyboard-subkeys {
  color: {{menu.text}};
  -arrow-border-radius: {{menu.r2}}px;
  -arrow-background-color: {{mix(menu.menu_bg, menu.base, 0.05)}};
  -arrow-border-width: 1px;
  -arrow-border-color: {{menu.base}};
  -arrow-base: 20px;
  -arrow-rise: 10px;
  -boxpointer-gap: 6px; }

.word-suggestions {
  font-size: 1.227em;
  spacing: 20px;
  min-height: 20pt; }

.candidate-popup-boxpointer {
  -arrow-border-radius: {{menu.r2}}px;
  -arrow-background-color: {{mix(menu.menu_bg, menu.base, 0.05)}};
  -arrow-border-width: 1px;
  -arrow-border-color: {{mix(menu.menu_bg, menu.text, 0.273)}};
  -arrow-base: 12px;
  -arrow-rise: 6px;
  -arrow-box-shadow: 0 1px 3px {{alpha(menu.text, 0.5)}}; }

.candidate-popup-content {
  padding: 0.5em;
  spacing: 0.3em; }

.candidate-index {
  padding: 0 0.5em 0 0;
  color: {{darker(menu.text, 0.521)}}; }

.candidate-box {
  padding: 0.3em 0.5em 0.3em 0.5em;
  border-radius: {{menu.r2}}px;
  color: {{menu.text}}; }
  .candidate-box:selected, .candidate-box:hover {
    background-color: {{mix(menu.menu_bg, menu.text, 0.219)}}; }

.candidate-page-button-box {
  height: 2em; }
  .vertical .candidate-page-button-box {
    padding-top: 0.5em; }
  .horizontal .candidate-page-button-box {
    padding-left: 0.5em; }

.candidate-page-button {
  padding: 4px; }

.candidate-page-button-previous {
  border-radius: {{menu.r2}}px 0px 0px {{menu.r2}}px;
  border-right-width: 0; }

.candidate-page-button-next {
  border-radius: 0px {{menu.r2}}px {{menu.r2}}px 0px; }

.candidate-page-button-icon {
  icon-size: 1em; }

.screen-shield {
  background-color: {{darker(menu.text, 1)}};
  color: {{menu.accent_fg}}; }
  .screen-shield .screen-shield-background {
    background-color: {{darker(menu.text, 1)}}; }
  .screen-shield .icon-button {
    border-radius: 9999px;
    min-height: 16px;
    padding: 1.091em;
    color: {{menu.accent_fg}};
    border: 1px solid {{alpha(menu.base, 0.1)}};
    background-color: {{alpha(menu.base, 0.15)}};
    margin-left: 6px;
    margin-right: 6px; }
    .screen-shield .icon-button StIcon {
      icon-size: 16px; }
    .screen-shield .icon-button:hover, .screen-shield .icon-button:focus {
      background-color: {{alpha(menu.base, 0.22)}}; }
    .screen-shield .icon-button:active {
      background-color: {{alpha(menu.base, 0.3)}}; }
  .screen-shield .prompt-dialog {
    width: 34em;
    background-color: transparent;
    border: none;
    padding: 0;
    spacing: 24px; }
    .screen-shield .prompt-dialog .user-widget-label {
      font-weight: 400;
      font-size: 1.818em;
      margin-bottom: .75em;
      color: {{menu.accent_fg}}; }
    .screen-shield .prompt-dialog .user-icon {
      icon-size: 128px;
      border: 2px solid {{alpha(menu.base, 0.2)}}; }
      .screen-shield .prompt-dialog .user-icon StIcon {
        padding: 30px; }
    .screen-shield .prompt-dialog-password-entry {
      width: 20em;
      padding: 7px;
      border-radius: {{menu.r2}}px;
      caret-size: 1px;
      caret-color: {{menu.base}};
      color: {{menu.accent_fg}};
      background-color: {{alpha(menu.base, 0.2)}};
      border: 1px solid {{alpha(menu.base, 0.4)}};
      selection-background-color: {{menu.accent}};
      selected-color: {{menu.base}};
      transition-duration: 300ms; }
      .screen-shield .prompt-dialog-password-entry:focus {
        border-color: {{menu.accent}}; }
      .screen-shield .prompt-dialog-password-entry StIcon.capslock-warning {
        icon-size: 16px;
        warning-color: #F27835;
        padding: 0 4px; }
      .screen-shield .prompt-dialog-password-entry StLabel.hint-text {
        color: {{alpha(menu.accent_fg, 0.5)}}; }
      .screen-shield .prompt-dialog-password-entry StIcon.peek-password {
        icon-size: 16px;
        color: {{menu.accent_fg}}; }
  .screen-shield .clock-widget {
    padding: 6px;
    spacing: 6px; }
    .screen-shield .clock-widget .clock-time-label {
      font-size: 6.546em;
      color: {{menu.accent_fg}}; }
    .screen-shield .clock-widget .clock-date-label {
      color: {{menu.accent_fg}}; }
    .screen-shield .clock-widget .clock-message-label {
      font-size: 14pt;
      color: {{mix(menu.menu_bg, menu.text, 0.166)}};
      margin-top: 4px; }
    .screen-shield .clock-widget .clock-message-author {
      font-size: 12pt;
      color: {{mix(menu.menu_bg, menu.text, 0.337)}};
      text-align: center; }
  .screen-shield .albumart-widget {
    padding: 12px;
    spacing: 12px;
    min-width: 400px;
    color: {{menu.accent_fg}};
    background-color: {{alpha(menu.base, 0.15)}};
    border: 1px solid {{alpha(menu.base, 0.1)}};
    border-radius: 18px; }
    .screen-shield .albumart-widget .albumart-track-info-box {
      spacing: 3px;
      max-width: 300px; }
      .screen-shield .albumart-widget .albumart-track-info-box .albumart-title {
        font-weight: bold; }
      .screen-shield .albumart-widget .albumart-track-info-box .albumart-controls {
        spacing: 6px;
        padding-top: 6px; }
        .screen-shield .albumart-widget .albumart-track-info-box .albumart-controls .icon-button {
          padding: 0.546em; }
      .screen-shield .albumart-widget .albumart-track-info-box .albumart-volume-box {
        spacing: 6px; }
        .screen-shield .albumart-widget .albumart-track-info-box .albumart-volume-box .albumart-volume-icon {
          icon-size: 16px; }
        .screen-shield .albumart-widget .albumart-track-info-box .albumart-volume-box .albumart-volume-slider {
          height: 20px;
          min-width: 280px;
          -slider-height: 4px;
          -slider-background-color: {{alpha(menu.base, 0.2)}};
          -slider-border-color: transparent;
          -slider-active-background-color: {{menu.accent}};
          -slider-active-border-color: transparent;
          -slider-border-width: 0;
          -slider-handle-radius: {{menu.r2}}px; }
  .screen-shield .info-panel {
    padding: 8px;
    spacing: 12px; }
    .screen-shield .info-panel .notification-widget {
      spacing: 4px; }
      .screen-shield .info-panel .notification-widget .notification-widget-label {
        color: {{menu.accent_fg}};
        font-size: 12pt;
        font-weight: bold;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); }
      .screen-shield .info-panel .notification-widget .notification-widget-icon {
        color: {{menu.accent_fg}};
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); }
    .screen-shield .info-panel .power-widget-icon {
      color: {{menu.accent_fg}};
      text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); }
      .screen-shield .info-panel .power-widget-icon-critical {
