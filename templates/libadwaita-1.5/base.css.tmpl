/* ==========================================================================
   xl-Cheeselooks for libadwaita: the GTK 4 layer (same rules and tokens as
   plain GTK 4 apps), then libadwaita-specific additions below.
   ========================================================================== */
{{include "../gtk-4.0/xl.css.tmpl"}}

/* --------------------------------------------------------------------------
   libadwaita-specific
   -------------------------------------------------------------------------- */
/* Header bars in a toolbar view are transparent and the top bar behind them
   is painted: give it the title bar gradient, as GTK 3 headerbars have
   (flat when the window is unfocused, so it matches the content below) */
toolbarview > .top-bar {
  color: {{wb.text}};
  background-color: {{wb.title}};
  background-image: linear-gradient(to bottom, {{wb.title_top}}, {{wb.title_bottom}}); }
toolbarview > .top-bar:backdrop {
  color: {{wb.unfocused_text}};
  background-color: {{wb.unfocused}};
  background-image: image({{wb.unfocused}}); }
toolbarview > .top-bar headerbar { background: none; box-shadow: none; }

/* Cards and boxed lists: your roundness (window radius) instead of a fixed 12px */
list.boxed-list, list.content, .card, menubutton.card > button { border-radius: {{r2}}px; }
list.boxed-list > row:first-child, list.content > row:first-child,
list.boxed-list > row:first-child.expander row.header, list.content > row:first-child.expander row.header {
  border-top-left-radius: {{r2}}px; border-top-right-radius: {{r2}}px; }
list.boxed-list > row:last-child, list.content > row:last-child,
list.boxed-list > row:last-child.expander:not(:checked), list.boxed-list > row:last-child.expander:not(:checked) row.header,
list.content > row:last-child.expander:not(:checked) row.header {
  border-bottom-left-radius: {{r2}}px; border-bottom-right-radius: {{r2}}px; }
