   hovered or pressed button lands on top of the next button's left border. */
.nemo-window .linked.path-bar > button:hover:not(:last-child) {
  box-shadow: {{w.linked.nemo_hover_seam_shadow}}; }
.nemo-window .linked.path-bar > button:checked:not(:last-child),
.nemo-window .linked.path-bar > button:active:not(:last-child) {
  box-shadow: {{w.linked.nemo_pressed_seam_shadow}}; }
.nemo-window .linked.path-bar > button:backdrop:hover:not(:last-child) {
  box-shadow: {{bd.w.linked.nemo_hover_seam_shadow}}; }
.nemo-window .linked.path-bar > button:backdrop:checked:not(:last-child) {
  box-shadow: {{bd.w.linked.nemo_pressed_seam_shadow}}; }

/* Unfocused windows: accent and delete buttons at the Unfocused depth too */
button.suggested-action:backdrop, headerbar button.suggested-action:backdrop,
.primary-toolbar button.suggested-action:backdrop {
  box-shadow: {{bd.w.suggested.shadow}}; }
button.destructive-action:backdrop, headerbar button.destructive-action:backdrop {
  box-shadow: {{bd.w.destructive.shadow}}; }

/* Pictures framed inside buttons: Cinnamon settings' theme pickers frame each
   theme's thumbnail (its icon and pointer pickers don't); no border, so the
   thumbnail sits on the button like the others */
button > box > frame > border { border: none; box-shadow: none; }

/* List column headers are buttons, but flat strips: no drop shadow (each
   header's fell on the next one) */
treeview.view header button, treeview.view header button:hover,
treeview.view header button:active, treeview.view header button:checked {
  box-shadow: none; }

/* Buttons on colored backgrounds (info bars, selected rows, selection mode):
   keep the see-through look so their light text stays readable */
infobar.info button, infobar.question button, infobar.warning button, infobar.error button,
row:selected button, headerbar.selection-mode button, .selection-mode.primary-toolbar button {
  background-image: none;
  box-shadow: none; }

/* Suggested (accent) and destructive buttons */
button.suggested-action, headerbar button.suggested-action, .primary-toolbar button.suggested-action {
  color: {{accent_fg}};
  border-color: {{w.suggested.border}};
  background-color: {{accent}};
  background-image: {{accent_grad}};
  box-shadow: {{w.suggested.shadow}}; }
button.suggested-action:hover, headerbar button.suggested-action:hover, .primary-toolbar button.suggested-action:hover {
  color: {{accent_fg}};
  border-color: {{w.suggested.hover_border}};
  background-color: {{w.suggested.hover_color}};
  background-image: {{w.suggested.hover_grad}};
  box-shadow: {{w.suggested.hover_shadow}}; }
button.suggested-action:active, button.suggested-action:checked,
headerbar button.suggested-action:active, .primary-toolbar button.suggested-action:active {
  color: {{accent_fg}};
  border-color: {{w.suggested.pressed_border}};
  background-color: {{accent_press}};
  background-image: image({{accent_press}});
  box-shadow: {{w.suggested.pressed_shadow}}; }
button.suggested-action:disabled {
  color: {{alpha(accent_fg, 0.6)}};
  background-image: image({{alpha(accent, 0.5)}});
  box-shadow: none; }

button.destructive-action, headerbar button.destructive-action, .primary-toolbar button.destructive-action {
  color: {{destructive_fg}};
  border-color: {{destructive_border}};
  background-color: {{destructive}};
  background-image: {{destructive_grad}};
  box-shadow: {{w.destructive.shadow}}; }
button.destructive-action:hover, headerbar button.destructive-action:hover {
  color: {{destructive_fg}};
  border-color: {{destructive_hover_border}};
  background-image: linear-gradient(to bottom, {{lighter(destructive_top, 0.12)}}, {{lighter(destructive_bottom, 0.12)}});
  box-shadow: {{w.destructive.hover_shadow}}; }
button.destructive-action:active, headerbar button.destructive-action:active {
  border-color: {{destructive_pressed_border}};
  background-image: image({{darker(destructive, 0.14)}});
  box-shadow: {{w.destructive.pressed_shadow}}; }

/* Suggested and destructive buttons in a header bar sit on the title bar: their
   border and edge layers (highlight, recess, shadow) come from the title bar's
   palette, as the other title-bar buttons' do, so a pale-on-light edge tuned
   for the window doesn't show up on a dark or coloured title bar */
headerbar button.suggested-action {
  border-color: {{wbp.sug.border}};
  box-shadow: {{wbp.sug.shadow}}; }
headerbar button.suggested-action:hover {
  border-color: {{wbp.sug.hover_border}};
  box-shadow: {{wbp.sug.hover_shadow}}; }
headerbar button.suggested-action:active {
  border-color: {{wbp.sug.pressed_border}};
  box-shadow: {{wbp.sug.pressed_shadow}}; }
headerbar button.suggested-action:backdrop {
  box-shadow: {{bd.wbp.sug.shadow}}; }
headerbar button.destructive-action {
  box-shadow: {{wbp.w.destructive.shadow}}; }
headerbar button.destructive-action:hover {
  box-shadow: {{wbp.w.destructive.hover_shadow}}; }
headerbar button.destructive-action:active {
  box-shadow: {{wbp.w.destructive.pressed_shadow}}; }

/* --------------------------------------------------------------------------
   Title bars and headerbars
   -------------------------------------------------------------------------- */
headerbar, .titlebar:not(headerbar) {
  min-height: {{wb.height_inner}}px;
  color: {{wb.text}};
  border-color: {{wb.line}};      /* the line under the header bar: dividers, else the border */
  background-color: {{wb.title}};
  background-image: {{wb.title_grad}};
  box-shadow: {{wb.highlight}}; }     /* top highlight: [title_bar] highlight in the style */
/* ...also where Mint-Y's base sets it for windows that draw their own title
   bar (a more specific rule than the one above) */
.csd headerbar, .csd .titlebar:not(headerbar) {
  border-color: {{wb.line}}; }
headerbar:backdrop, .titlebar:not(headerbar):backdrop {
  color: {{wb.unfocused_text}};
  background-color: {{wb.unfocused}};
  background-image: image({{wb.unfocused}}); }
headerbar.default-decoration, .titlebar.default-decoration {
  min-height: {{wb.button_h}}px; }
/* Window borders on windows Cinnamon decorates (Muffin 6, Mint 22: it no
   longer reads metacity-1, it draws frames from these CSS nodes, muffin
   src/ui/theme.c). The frame's width is decoration's border and padding,
   drawn with gtk_render_frame; the title bar is drawn over the frame's top,
   full width. So: the frame's sides and bottom are decoration's border; the
   top and the title bar's sides are inset lines inside the title bar (a
   border there would make it taller and move its buttons).
   A shadow there isn't a border: Muffin draws it outside the frame, in the
   resize area. The frame needs a background too: with compositing, Muffin
   takes the frame's see-through parts from decoration's and the title bar's
   backgrounds only (frames.c, meta_ui_frame_get_mask), so a border over a
   transparent background is drawn and then masked away (xl_cheese saw a 4px
   see-through gap). Maximized and tiled windows (Muffin's "maximized" and "tiled"
   classes on the window) have none. */
.ssd decoration {
  border: {{wb.border_width}}px solid {{wb.border}};
  border-top-width: 0;
  background-color: {{wb.border}};
  background-clip: border-box;      /* under the border too (Mint-Y's base clips to the padding) */
  box-shadow: none; }
.ssd decoration:backdrop {
  border-color: {{wb.border_unfocused}};
  background-color: {{wb.border_unfocused}};
  box-shadow: none; }
.ssd headerbar.titlebar.default-decoration {
  box-shadow: {{wb.ssd_title_focused}}; }
.ssd headerbar.titlebar.default-decoration:backdrop {
  box-shadow: {{wb.ssd_title_unfocused}}; }
.ssd.maximized decoration, .ssd.tiled decoration,
.ssd.maximized decoration:backdrop, .ssd.tiled decoration:backdrop {
  border-width: 0; }
.ssd.maximized headerbar.titlebar.default-decoration, .ssd.tiled headerbar.titlebar.default-decoration,
.ssd.maximized headerbar.titlebar.default-decoration:backdrop, .ssd.tiled headerbar.titlebar.default-decoration:backdrop {
  box-shadow: {{wb.highlight}}; }
window.csd > .titlebar, window.csd > headerbar,
window.csd > .titlebar:backdrop, window.csd > headerbar:backdrop {
  border-radius: {{wb.r}}px {{wb.r}}px 0 0; }
.maximized .titlebar, .tiled .titlebar, .fullscreen .titlebar,
.maximized headerbar, .tiled headerbar, .fullscreen headerbar {
  border-radius: 0; }

decoration, window.csd decoration {
  border-radius: {{wb.r}}px {{wb.r}}px 0 0;
  box-shadow: 0 3px 9px 1px rgba(0, 0, 0, 0.35), 0 0 0 {{wb.border_width}}px {{wb.border}}; }
decoration:backdrop, window.csd decoration:backdrop {
  box-shadow: 0 3px 9px 1px transparent, 0 2px 6px 2px rgba(0, 0, 0, 0.2), 0 0 0 {{wb.border_width}}px {{wb.border}}; }
.maximized decoration, .tiled decoration, .fullscreen decoration {
  border-radius: 0;
  box-shadow: none; }
/* Round bottom corners (Window Borders): windows that draw their own title
   bar only. Muffin's frames stay square at the bottom: the app's contents
   inside them are square, and only the compositor could trim them. GTK 3
   doesn't trim a window's contents either, so something drawn right at the
   bottom edge can still show a square corner. */
window.csd decoration {
  border-radius: {{wb.r}}px {{wb.r}}px {{wb.r_bottom}}px {{wb.r_bottom}}px; }
window.background.csd {
  border-bottom-left-radius: {{wb.r_bottom}}px;
  border-bottom-right-radius: {{wb.r_bottom}}px; }
{{wb.bottom3.css}}
window.csd.maximized decoration, window.csd.tiled decoration, window.csd.fullscreen decoration,
window.background.csd.maximized, window.background.csd.tiled, window.background.csd.fullscreen {
  border-radius: 0; }

{{titlebuttons.css}}
/* Other headerbar buttons: on the title bar, so their hover and pressed faces
   come from the title bar's palette too (the same as toolbar buttons when the
   title bar follows the theme) */
headerbar button:hover {
