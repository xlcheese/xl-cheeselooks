/* ==========================================================================
   xl-Cheeselooks layer for GTK 3, drawn on top of base.css.
   Style: {{style_name}}. Edges, shape, gradients, timing and details all
   come from your settings. See docs/design-spec.md.
   ========================================================================== */

/* --------------------------------------------------------------------------
   Hover timing: hover appears at "Hover in", fades at "Hover out",
   pressing is always instant.
   -------------------------------------------------------------------------- */
button, button.flat, button.sidebar-button, entry, spinbutton, combobox button,
menuitem, menubar > menuitem, notebook > header > tabs > tab, row, treeview.view,
iconview, flowboxchild, switch, switch slider, check, radio, scale slider, scrollbar slider,
.primary-toolbar button, headerbar button, headerbar button.titlebutton, .titlebar button.titlebutton {
  transition-duration: {{hover_out_ms}}ms;
  transition-timing-function: ease-out;
  transition-delay: 0; }

button:hover, button.flat:hover, button.sidebar-button:hover, entry:hover, spinbutton:hover,
menuitem:hover, menubar > menuitem:hover, notebook > header > tabs > tab:hover, row:hover,
treeview.view:hover, iconview:hover, flowboxchild:hover, switch:hover, check:hover, radio:hover,
scale slider:hover, scrollbar slider:hover,
.primary-toolbar button:hover, headerbar button:hover,
headerbar button.titlebutton:hover, .titlebar button.titlebutton:hover {
  transition-duration: {{hover_in_ms}}ms; }

button:active, button:checked, button.flat:active, button.flat:hover:active,
button.sidebar-button:hover:active, .primary-toolbar button:active, headerbar button:active,
menuitem:active, row:active, switch:active, check:active, radio:active, scale slider:active {
  transition: none; }

/* --------------------------------------------------------------------------
   Buttons: style edges + gradient
   -------------------------------------------------------------------------- */
button {
  min-height: {{button_min_h}}px;
  border-radius: {{r}}px;
  border-color: {{w.button.border}};
  background-color: {{button}};
  background-image: {{button_grad}};
  box-shadow: {{w.button.shadow}}; }
button:hover {
  border-color: {{w.button.hover_border}};
  background-color: {{w.button.hover_color}};
  background-image: {{w.button.hover_grad}};
  box-shadow: {{w.button.hover_shadow}}; }
button:active, button:checked, button:hover:checked {
  border-color: {{w.button.pressed_border}};
  background-color: {{pressed}};
  background-image: linear-gradient(to bottom, {{pressed_bottom}}, {{pressed_top}});
  box-shadow: {{w.button.pressed_shadow}}; }
button:disabled {
  background-image: image({{alpha(button, 0.55)}});
  box-shadow: none; }
button:disabled:checked, button:disabled:active {
  background-image: image({{alpha(pressed, 0.6)}}); }

/* Flat buttons and toolbar / headerbar buttons: flat until hovered */
button.flat, button.sidebar-button, button.flat:disabled,
.primary-toolbar button, headerbar button, toolbar button {
  border-color: {{w.toolbar_button.border}};
  background-color: transparent;
  background-image: none;
  box-shadow: {{w.toolbar_button.shadow}}; }
button.flat:hover, button.sidebar-button:hover,
.primary-toolbar button:hover, headerbar button:hover, toolbar button:hover {
  border-color: {{w.toolbar_button.hover_border}};
  background-color: {{w.toolbar_button.hover_color}};
  background-image: {{w.toolbar_button.hover_grad}};
  box-shadow: {{w.toolbar_button.hover_shadow}}; }
button.flat:active, button.flat:checked, button.sidebar-button:active,
.primary-toolbar button:active, .primary-toolbar button:checked,
headerbar button:active, headerbar button:checked,
toolbar button:active, toolbar button:checked {
  border-color: {{w.toolbar_button.pressed_border}};
  background-color: {{pressed}};
  background-image: linear-gradient(to bottom, {{pressed_bottom}}, {{pressed_top}});
  box-shadow: {{w.toolbar_button.pressed_shadow}}; }

/* Joined groups: the recess ring (edge layer "recess") goes round the whole
   group, on the box that holds the buttons. (Spin buttons are fields: they
   take it from the entry's edge.) */
.linked {
  border-radius: {{r}}px;
  box-shadow: {{w.linked.recess}}; }

/* Grouped (linked) buttons: inside edges only. Drop shadows would overlap the
   neighbouring button and make one look bigger than the others. Grouped buttons
   in toolbars (path bar, view switchers) stay raised as one group. */
.linked > button, .linked > combobox > box > button.combo, spinbutton > button {
  box-shadow: {{w.linked.inset_shadow}}; }
.linked > button:hover, .linked > combobox > box > button.combo:hover, spinbutton > button:hover {
  box-shadow: {{w.linked.hover_inset_shadow}}; }
.linked > button:active, .linked > button:checked, spinbutton > button:active {
  box-shadow: {{w.linked.pressed_inset_shadow}}; }
.primary-toolbar .linked > button, headerbar .linked > button, toolbar .linked > button,
.path-bar button, .nemo-window .path-bar button {
  border-color: {{w.linked.border}};
  background-color: {{button}};
  background-image: {{button_grad}};
  box-shadow: {{w.linked.inset_shadow}}; }
.primary-toolbar .linked > button:hover, headerbar .linked > button:hover, toolbar .linked > button:hover,
.path-bar button:hover {
  border-color: {{w.linked.hover_border}};
  background-image: {{w.linked.hover_grad}};
  box-shadow: {{w.linked.hover_inset_shadow}}; }
.primary-toolbar .linked > button:active, .primary-toolbar .linked > button:checked,
headerbar .linked > button:active, headerbar .linked > button:checked,
toolbar .linked > button:checked, .path-bar button:checked, .path-bar button:active {
  border-color: {{w.linked.pressed_border}};
  background-image: linear-gradient(to bottom, {{pressed_bottom}}, {{pressed_top}});
  box-shadow: {{w.linked.pressed_inset_shadow}}; }

/* Joined buttons share the edge between them (Mint-Y drops each button's right
   border; vertical groups drop the bottom one). When a button is hovered or
   pressed, the next button colors the shared edge to match, so the hovered
   button looks outlined on all four sides. */
.linked:not(.vertical) > button:hover + button,
.primary-toolbar .linked:not(.vertical) > button:hover + button,
.primary-toolbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:hover + button,
.primary-toolbar .linked:not(.vertical).path-bar > button:hover + button,
headerbar .linked:not(.vertical) > button:hover + button,
headerbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:hover + button,
headerbar .linked:not(.vertical).path-bar > button:hover + button,
.primary-toolbar toolbar .linked:not(.vertical) > button:hover + button,
.primary-toolbar toolbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:hover + button,
.primary-toolbar toolbar .linked:not(.vertical).path-bar > button:hover + button,
.primary-toolbar .inline-toolbar .linked:not(.vertical) > button:hover + button,
.primary-toolbar .inline-toolbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:hover + button,
.primary-toolbar .inline-toolbar .linked:not(.vertical).path-bar > button:hover + button {
  border-left-color: {{w.linked.hover_border}}; }
.linked:not(.vertical) > button:checked + button,
.primary-toolbar .linked:not(.vertical) > button:checked + button,
.primary-toolbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:checked + button,
.primary-toolbar .linked:not(.vertical).path-bar > button:checked + button,
headerbar .linked:not(.vertical) > button:checked + button,
headerbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:checked + button,
headerbar .linked:not(.vertical).path-bar > button:checked + button,
.primary-toolbar toolbar .linked:not(.vertical) > button:checked + button,
.primary-toolbar toolbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:checked + button,
.primary-toolbar toolbar .linked:not(.vertical).path-bar > button:checked + button,
.primary-toolbar .inline-toolbar .linked:not(.vertical) > button:checked + button,
.primary-toolbar .inline-toolbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:checked + button,
.primary-toolbar .inline-toolbar .linked:not(.vertical).path-bar > button:checked + button,
.linked:not(.vertical) > button:active + button,
.primary-toolbar .linked:not(.vertical) > button:active + button,
.primary-toolbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:active + button,
.primary-toolbar .linked:not(.vertical).path-bar > button:active + button,
headerbar .linked:not(.vertical) > button:active + button,
headerbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:active + button,
headerbar .linked:not(.vertical).path-bar > button:active + button,
.primary-toolbar toolbar .linked:not(.vertical) > button:active + button,
.primary-toolbar toolbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:active + button,
.primary-toolbar toolbar .linked:not(.vertical).path-bar > button:active + button,
.primary-toolbar .inline-toolbar .linked:not(.vertical) > button:active + button,
.primary-toolbar .inline-toolbar .linked:not(.vertical):not(.path-bar).stack-switcher > button:active + button,
.primary-toolbar .inline-toolbar .linked:not(.vertical).path-bar > button:active + button {
  border-left-color: {{w.linked.pressed_border}}; }
.linked.vertical > button:hover + button {
  border-top-color: {{w.linked.hover_border}}; }
.linked.vertical > button:checked + button, .linked.vertical > button:active + button {
  border-top-color: {{w.linked.pressed_border}}; }

/* Nemo draws its own path bar and never updates a button's style when its
   neighbor is hovered, so the rules above can't reach the shared edge there.
   Nemo paints its buttons right to left, so a 1px outer shadow on the
   hovered or pressed button lands on top of the next button's left border. */
.nemo-window .linked.path-bar > button:hover:not(:last-child) {
  box-shadow: {{w.linked.hover_seam_shadow}}; }
.nemo-window .linked.path-bar > button:checked:not(:last-child),
.nemo-window .linked.path-bar > button:active:not(:last-child) {
  box-shadow: {{w.linked.pressed_seam_shadow}}; }

/* Buttons on colored backgrounds (info bars, selected rows, selection mode):
   keep the see-through look so their light text stays readable */
infobar.info button, infobar.question button, infobar.warning button, infobar.error button,
row:selected button, headerbar.selection-mode button, .selection-mode.primary-toolbar button {
  background-image: none;
  box-shadow: none; }

/* Suggested (accent) and destructive buttons */
button.suggested-action, headerbar button.suggested-action, .primary-toolbar button.suggested-action {
  color: {{accent_fg}};
  border-color: {{w.suggested.border}};
  background-color: {{accent}};
  background-image: {{accent_grad}};
  box-shadow: {{w.suggested.shadow}}; }
button.suggested-action:hover, headerbar button.suggested-action:hover, .primary-toolbar button.suggested-action:hover {
  color: {{accent_fg}};
  border-color: {{w.suggested.hover_border}};
  background-color: {{w.suggested.hover_color}};
  background-image: {{w.suggested.hover_grad}};
  box-shadow: {{w.suggested.hover_shadow}}; }
button.suggested-action:active, button.suggested-action:checked,
headerbar button.suggested-action:active, .primary-toolbar button.suggested-action:active {
  color: {{accent_fg}};
  border-color: {{w.suggested.pressed_border}};
  background-color: {{accent_press}};
  background-image: image({{accent_press}});
  box-shadow: {{w.suggested.pressed_shadow}}; }
button.suggested-action:disabled {
  color: {{alpha(accent_fg, 0.6)}};
  background-image: image({{alpha(accent, 0.5)}});
  box-shadow: none; }

button.destructive-action, headerbar button.destructive-action, .primary-toolbar button.destructive-action {
  color: {{destructive_fg}};
  border-color: {{darker(destructive, 0.14)}};
  background-color: {{destructive}};
  background-image: {{destructive_grad}};
  box-shadow: {{w.destructive.shadow}}; }
button.destructive-action:hover, headerbar button.destructive-action:hover {
  color: {{destructive_fg}};
  background-image: linear-gradient(to bottom, {{lighter(destructive_top, 0.12)}}, {{lighter(destructive_bottom, 0.12)}});
  box-shadow: {{w.destructive.hover_shadow}}; }
button.destructive-action:active, headerbar button.destructive-action:active {
  background-image: image({{darker(destructive, 0.14)}});
  box-shadow: {{w.destructive.pressed_shadow}}; }

/* --------------------------------------------------------------------------
   Title bars and headerbars
   -------------------------------------------------------------------------- */
headerbar, .titlebar:not(headerbar) {
  min-height: {{wb.height_inner}}px;
  color: {{wb.text}};
  border-color: {{wb.border}};
  background-color: {{wb.title}};
  background-image: linear-gradient(to bottom, {{wb.title_top}}, {{wb.title_bottom}}); }
headerbar:backdrop, .titlebar:not(headerbar):backdrop {
  color: {{wb.unfocused_text}};
  background-color: {{wb.unfocused}};
  background-image: image({{wb.unfocused}}); }
headerbar.default-decoration, .titlebar.default-decoration {
  min-height: {{wb.button_h}}px; }
window.csd > .titlebar, window.csd > headerbar,
window.csd > .titlebar:backdrop, window.csd > headerbar:backdrop {
  border-radius: {{r2}}px {{r2}}px 0 0; }
.maximized .titlebar, .tiled .titlebar, .fullscreen .titlebar,
.maximized headerbar, .tiled headerbar, .fullscreen headerbar {
  border-radius: 0; }

decoration, window.csd decoration {
  border-radius: {{r2}}px {{r2}}px 0 0;
  box-shadow: 0 3px 9px 1px rgba(0, 0, 0, 0.35), 0 0 0 {{wb.border_width}}px {{wb.border}}; }
decoration:backdrop, window.csd decoration:backdrop {
  box-shadow: 0 3px 9px 1px transparent, 0 2px 6px 2px rgba(0, 0, 0, 0.2), 0 0 0 {{wb.border_width}}px {{wb.border}}; }
.maximized decoration, .tiled decoration, .fullscreen decoration {
  border-radius: 0;
  box-shadow: none; }

{{titlebuttons.css}}
/* Other headerbar buttons: on the title bar, so their hover and pressed faces
   come from the title bar's palette too (the same as toolbar buttons when the
   title bar follows the theme) */
headerbar button:hover {
  border-color: {{wbp.w.toolbar_button.hover_border}};
  background-color: {{wbp.w.toolbar_button.hover_color}};
  background-image: {{wbp.w.toolbar_button.hover_grad}};
  box-shadow: {{wbp.w.toolbar_button.hover_shadow}}; }
headerbar button:active, headerbar button:checked {
  border-color: {{wbp.w.toolbar_button.pressed_border}};
  background-color: {{wbp.pressed}};
  background-image: linear-gradient(to bottom, {{wbp.pressed_bottom}}, {{wbp.pressed_top}});
  box-shadow: {{wbp.w.toolbar_button.pressed_shadow}}; }

/* Menubar and toolbar: flat, same color as the bottom of the title bar */
menubar, .menubar, .primary-toolbar, toolbar.primary-toolbar,
.primary-toolbar:not(.libreoffice-toolbar), .primary-toolbar toolbar, .primary-toolbar .inline-toolbar {
  background-color: {{header}};
  background-image: none; }

/* --------------------------------------------------------------------------
   Menus
   -------------------------------------------------------------------------- */
menu, .menu, .context-menu, popover.menu {
  background-color: {{menu_bg}}; }
menu menuitem, .menu menuitem {
  padding: {{menu_pad}}px;
  border-radius: {{r}}px; }
menu menuitem:hover, .menu menuitem:hover, .context-menu menuitem:hover {
  color: {{w.menu_item.hover_fg}};
  background-color: {{w.menu_item.hover_color}};
  background-image: {{w.menu_item.hover_grad}}; }
popover modelbutton.flat:hover, popover modelbutton.flat:selected,
menuitem.button.flat:hover, menuitem.button.flat:selected {
  color: {{w.menu_item.hover_fg}};
  background-color: {{w.menu_item.hover_color}};
  background-image: {{w.menu_item.hover_grad}}; }
menubar > menuitem:hover, .menubar > menuitem:hover {
  color: {{w.menubar_item.hover_fg}};
  box-shadow: none;
  border-radius: {{r}}px;
  background-color: {{w.menubar_item.hover_color}};
  background-image: {{w.menubar_item.hover_grad}}; }
menubar > menuitem:hover label, .menubar > menuitem:hover label {
  color: inherit; }

/* --------------------------------------------------------------------------
   Selection: rows, icons, sidebars
   -------------------------------------------------------------------------- */
.view:selected, .view:selected:focus, iconview:selected, iconview:selected:focus,
treeview.view:selected, treeview.view:selected:focus,
row:selected, row:selected:focus, flowbox flowboxchild:selected {
  color: {{accent_fg}};
  background-color: {{select}};
  background-image: {{select_grad}}; }
selection, *:selected selection, entry selection, textview text selection, label selection {
  color: {{accent_fg}};
  background-color: {{select}}; }

.sidebar, placessidebar, placessidebar > viewport, placessidebar list,
.nemo-window .sidebar, .nemo-places-sidebar {
  background-color: {{sidebar}}; }
.sidebar row, placessidebar row {
  border-radius: {{r}}px; }
/* Tree-view sidebars (Nemo) draw each cell separately; rounded corners would
   leave little dots between the icon and the name, so their rows stay square. */
.sidebar .view, .nemo-window .sidebar .view, .sidebar treeview.view {
  border-radius: 0; }
placessidebar row, .sidebar row { min-height: {{row_min_h}}px; }
row.activatable:hover:not(:selected), row.activatable.has-open-popup:not(:selected) {
  background-color: {{row_hover}}; }
.sidebar row:hover:not(:selected), placessidebar row:hover:not(:selected),
.sidebar .view:hover:not(:selected), .nemo-window .sidebar .view:hover:not(:selected) {
  background-color: {{sidebar_hover}};
  background-image: {{sidebar_hover_grad}}; }
.sidebar row:selected, placessidebar row:selected, .sidebar .view:selected,
.nemo-window .sidebar .view:selected {
  color: {{accent_fg}};
  background-color: {{select}};
  background-image: {{select_grad}}; }
placessidebar row:selected image, placessidebar row:selected label { color: {{accent_fg}}; }

/* Stack sidebars (a settings window's page list, e.g. this theme's own app):
   the sidebar colour, no divider lines (they'd stick out past rounded
   selections), and rows inset a little so the selection floats in the list */
stacksidebar.sidebar list, stacksidebar list {
  background-color: {{sidebar}}; }
stacksidebar list separator, stacksidebar list > separator {
  min-height: 0;
  margin: 0;
  background: none;
  border: none; }
stacksidebar row {
  margin: 2px 6px;
  border-radius: {{r}}px; }

/* --------------------------------------------------------------------------
   Entries
   -------------------------------------------------------------------------- */
entry, spinbutton:not(.vertical), spinbutton.vertical > entry {
  min-height: {{entry_min_h}}px;
  border-radius: {{r}}px;
  border-color: {{w.entry.border}};
  box-shadow: {{w.entry.shadow}}; }
entry:focus, spinbutton:focus:not(.vertical), spinbutton.vertical > entry:focus {
  border-color: {{w.entry.focus_border}};
  box-shadow: {{w.entry.focus_shadow}}; }
spinbutton:not(.vertical) > entry, spinbutton:not(.vertical) > entry:focus,
spinbutton:not(.vertical) > button, combobox entry {
  box-shadow: none; }

/* --------------------------------------------------------------------------
   Notebook tabs
   -------------------------------------------------------------------------- */
/* Shape and selected-tab marker come from the style's tab line (tab_kind,
   active_marker); written by cheeselooks/tabs.py. */
{{tabs.css}}

/* --------------------------------------------------------------------------
   Check boxes and radios (drawn in CSS; glyphs recolored from symbolic SVGs)
   -------------------------------------------------------------------------- */
check, radio, treeview.check, treeview.radio {
  min-width: 14px;
  min-height: 14px;
  border: 1px solid {{w.check.border}};
  border-radius: {{r_check}}px;
  color: transparent;
  background-color: {{base}};
  background-image: none;
  box-shadow: {{w.check.shadow}};
  -gtk-icon-source: none; }
radio, treeview.radio { border-radius: 50%; }
check:hover, radio:hover { border-color: {{accent}}; }
check:checked, radio:checked, check:indeterminate, radio:indeterminate,
treeview.check:checked, treeview.radio:checked {
  color: {{accent_fg}};
  border-color: {{accent_press}};
  background-color: {{accent}};
  background-image: {{accent_grad}}; }
check:checked, treeview.check:checked { -gtk-icon-source: -gtk-recolor(url("assets/check-symbolic.svg")); }
check:indeterminate, radio:indeterminate { -gtk-icon-source: -gtk-recolor(url("assets/dash-symbolic.svg")); }
radio:checked, treeview.radio:checked { -gtk-icon-source: -gtk-recolor(url("assets/bullet-symbolic.svg")); }
check:disabled, radio:disabled { opacity: 0.5; }
/* Check and radio items in popover menus are drawn by GTK only as an image
   (no CSS background or border), so they use small generated images. */
modelbutton.flat check, menuitem.button.flat check,
modelbutton.flat radio, menuitem.button.flat radio {
  min-width: 16px;
  min-height: 16px;
  border: none;
  background: none;
  box-shadow: none;
  -gtk-icon-source: url("assets/check-off.svg"); }
modelbutton.flat check:checked, menuitem.button.flat check:checked { -gtk-icon-source: url("assets/check-on.svg"); }
modelbutton.flat check:indeterminate, menuitem.button.flat check:indeterminate { -gtk-icon-source: url("assets/check-mixed.svg"); }
modelbutton.flat radio, menuitem.button.flat radio { -gtk-icon-source: url("assets/radio-off.svg"); }
modelbutton.flat radio:checked, menuitem.button.flat radio:checked { -gtk-icon-source: url("assets/radio-on.svg"); }
modelbutton.flat radio:indeterminate, menuitem.button.flat radio:indeterminate { -gtk-icon-source: url("assets/radio-mixed.svg"); }

menu menuitem check, menu menuitem radio, .menu menuitem check, .menu menuitem radio {
  margin: 0 4px 0 0; }
row:selected check, row:selected radio, .view:selected check, .view:selected radio {
  border-color: {{accent_fg}}; }

/* --------------------------------------------------------------------------
   Switches
   -------------------------------------------------------------------------- */
switch {
  font-size: inherit;
  min-width: 40px;
  min-height: 20px;
  padding: 0;
  border: 1px solid {{w.switch.border}};
  border-radius: {{switch.r}}px;
  color: transparent;
  background-color: {{trough}};
  background-image: none;
  box-shadow: {{w.switch.shadow}}; }
switch:checked {
  border-color: {{accent_press}};
  background-color: {{accent}};
  background-image: {{accent_grad}}; }
switch:disabled { opacity: 0.5; }
switch slider {
  min-width: 18px;
  min-height: 18px;
  margin: 1px;
  border: 1px solid {{alpha(black, 0.12)}};
  border-radius: {{switch.knob_r}}px;
  background-color: {{knob}};
  background-image: none;
  box-shadow: 0 1px 2px {{alpha(black, 0.25)}}; }
switch:hover slider { background-color: {{lighter(knob, 0.3)}}; }

/* --------------------------------------------------------------------------
   Sliders and progress bars
   -------------------------------------------------------------------------- */
scale trough, scale fill, scale highlight, progressbar trough, progressbar progress {
  border-radius: {{slider.track_r}}px; }
scale highlight, progressbar progress, levelbar block.filled {
  background-color: {{accent}};
  background-image: {{accent_grad}};
  border-color: {{accent_press}}; }
scale slider {
  min-width: 16px;
  min-height: 16px;
  border: 1px solid {{w.button.border}};
  border-radius: {{slider.handle_r}}px;
  background-color: {{button}};
  background-image: {{button_grad}};
  box-shadow: {{w.button.shadow}}; }
scale slider:hover {
  background-image: {{w.button.hover_grad}};
  box-shadow: {{w.button.hover_shadow}}; }

/* --------------------------------------------------------------------------
   Scrollbars, panes, tooltips, focus, terminal
   -------------------------------------------------------------------------- */
scrollbar slider {
  min-width: {{scrollbar.width}}px;
  min-height: {{scrollbar.width}}px;
  border-radius: {{scrollbar.r}}px; }
scrollbar.overlay-indicator:not(.dragging):not(.hovering) slider {
  border-radius: {{scrollbar.indicator_r}}px; }

paned > separator, paned.horizontal > separator, paned.vertical > separator {
  min-width: 1px;
  min-height: 1px;
  background-image: image({{border}});
  background-size: 1px 1px; }

tooltip, tooltip.background, .tooltip.background, tooltip.csd.background {
  color: {{tooltip.text}};
  background-color: {{tooltip.bg}};
  background-image: none;
  border: 1px solid {{mix(tooltip.bg, tooltip.text, 0.2)}};
  border-radius: {{r2}}px; }
tooltip label, tooltip.background label { color: {{tooltip.text}}; }

*:focus, button:focus, button:hover:focus, entry:focus, check:focus, radio:focus, switch:focus,
notebook > header > tabs > tab:focus, row:focus, .view:focus {
  outline-color: {{focus.ring}};
  outline-style: {{focus.style}};
  outline-width: {{focus.width}}px;
  -gtk-outline-radius: {{r}}px; }

vte-terminal, vte-terminal.terminal-screen, terminal-window vte-terminal {
  color: {{term.text}};
  background-color: {{term.bg}};
  caret-color: {{term.cursor}}; }

/* --------------------------------------------------------------------------
   Named colors that apps and window border themes read from the GTK theme.
   Muffin's title bars (Mint-Y's window borders, and ours) take their colors
   from the wm_* names, so they match the headerbars and toolbars.
   -------------------------------------------------------------------------- */
@define-color theme_base_color {{base}};
@define-color base_color {{base}};
@define-color content_view_bg {{base}};
@define-color insensitive_base_color {{base}};
@define-color theme_unfocused_base_color {{base}};
@define-color insensitive_fg_color {{alpha(text, 0.5)}};
@define-color wm_title {{wb.text}};
@define-color wm_title_unfocused {{wb.unfocused_text}};
@define-color wm_bg {{wb.title}};
@define-color wm_bg_unfocused {{wb.unfocused}};
@define-color wm_highlight {{wb.title_top}};
@define-color wm_border {{wb.border}};
@define-color wm_border_unfocused {{wb.border}};
@define-color wm_button_close_bg {{accent}};
@define-color wm_button_close_hover_bg {{accent_hover}};
@define-color wm_button_close_active_bg {{accent_press}};
@define-color wm_icon_close_bg {{accent_fg}};
@define-color wm_button_hover_bg {{flat_hover}};
@define-color wm_button_active_bg {{pressed}};
@define-color wm_icon_bg {{wb.text}};
@define-color wm_icon_unfocused_bg {{wb.unfocused_text}};
@define-color wm_icon_hover_bg {{wb.text}};
@define-color wm_icon_active_bg {{wb.text}};

/* --------------------------------------------------------------------------
   Extra CSS from the style (extra.css), if any
   -------------------------------------------------------------------------- */
{{style.extra_css}}

/* list text color: set here, or another theme's (e.g. black from a light
   system theme in the settings app's preview) shows through */
list { color: {{text}}; }
