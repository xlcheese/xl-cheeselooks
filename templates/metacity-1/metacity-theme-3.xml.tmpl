<?xml version="1.0"?>
<!-- Generated by xl-Cheeselooks from your settings: edits here are overwritten.
     Button glyphs are Linux Mint's Mint-Y artwork (GPL-3+). -->
<metacity_theme>
<info>
  <name>xl-Cheeselooks</name>
  <author>xl_cheese</author>
  <copyright>GPL-3.0</copyright>
  <date>2026</date>
  <description>Window borders for xl-Cheeselooks, style {{style_name}}.</description>
</info>

<!-- ::: GEOMETRY ::: -->

<frame_geometry name="normal" title_scale="medium" rounded_top_left="{{wb.radius}}" rounded_top_right="{{wb.radius}}">
	<distance name="left_width" value="{{wb.side}}"/>
	<distance name="right_width" value="{{wb.side}}"/>
	<distance name="bottom_height" value="{{wb.side}}"/>
	<distance name="left_titlebar_edge" value="{{wb.edge}}"/>
	<distance name="right_titlebar_edge" value="{{wb.edge}}"/>
	<distance name="title_vertical_pad" value="0"/>
	<border name="title_border" left="12" right="12" top="0" bottom="0"/>
	<border name="button_border" left="{{wb.button_gap}}" right="{{wb.button_gap}}" top="{{wb.button_pad_top}}" bottom="{{wb.button_pad_bottom}}"/>
	<distance name="button_width" value="{{wb.tb_w}}"/>
	<distance name="button_height" value="{{wb.tb_h}}"/>
</frame_geometry>

<frame_geometry name="maximized" parent="normal" rounded_top_left="false" rounded_top_right="false">
	<distance name="left_width" value="0"/>
	<distance name="right_width" value="0"/>
	<distance name="bottom_height" value="0"/>
</frame_geometry>

<frame_geometry name="tiled_left" parent="normal" rounded_top_left="false" rounded_top_right="false">
	<distance name="left_width" value="0"/>
	<distance name="bottom_height" value="0"/>
</frame_geometry>

<frame_geometry name="tiled_right" parent="normal" rounded_top_left="false" rounded_top_right="false">
	<distance name="right_width" value="0"/>
	<distance name="bottom_height" value="0"/>
</frame_geometry>

<frame_geometry name="utility" parent="normal" title_scale="small" rounded_top_left="false" rounded_top_right="false">
</frame_geometry>

<frame_geometry name="border" has_title="false" rounded_top_left="false" rounded_top_right="false">
	<distance name="left_width" value="{{wb.side}}"/>
	<distance name="right_width" value="{{wb.side}}"/>
	<distance name="bottom_height" value="{{wb.side}}"/>
	<distance name="left_titlebar_edge" value="0"/>
	<distance name="right_titlebar_edge" value="0"/>
	<distance name="button_width" value="0"/>
	<distance name="button_height" value="0"/>
	<distance name="title_vertical_pad" value="{{wb.side}}"/>
	<border name="title_border" left="0" right="0" top="0" bottom="0"/>
	<border name="button_border" left="0" right="0" top="0" bottom="0"/>
</frame_geometry>

<frame_geometry name="attached" parent="normal" hide_buttons="true">
</frame_geometry>

<!-- ::: BACKGROUND AND BORDERS ::: -->

<draw_ops name="background_focused">
	<rectangle color="{{wb.title}}" x="0" y="0" width="width" height="height" filled="true"/>
</draw_ops>
<draw_ops name="background_unfocused">
	<rectangle color="{{wb.unfocused}}" x="0" y="0" width="width" height="height" filled="true"/>
</draw_ops>

<draw_ops name="border_focused">
	{{wb.ops.border_focused}}
</draw_ops>
<draw_ops name="border_unfocused">
	{{wb.ops.border_unfocused}}
</draw_ops>
<draw_ops name="border_tiled_left_focused">
	{{wb.ops.border_right_focused}}
</draw_ops>
<draw_ops name="border_tiled_left_unfocused">
	{{wb.ops.border_right_unfocused}}
</draw_ops>
<draw_ops name="border_tiled_right_focused">
	{{wb.ops.border_left_focused}}
</draw_ops>
<draw_ops name="border_tiled_right_unfocused">
	{{wb.ops.border_left_unfocused}}
</draw_ops>

<!-- ::: TITLE BAR: the gradient ends in the menubar/toolbar color; unfocused is flat ::: -->

<draw_ops name="titlebar_focused">
	<gradient type="vertical" x="0" y="0" width="width" height="height">
		<color value="{{wb.title_top}}"/>
		<color value="{{wb.title_bottom}}"/>
	</gradient>
</draw_ops>
<draw_ops name="titlebar_unfocused">
	<rectangle color="{{wb.unfocused}}" x="0" y="0" width="width" height="height" filled="true"/>
</draw_ops>

<draw_ops name="title_focused">
	<title version="&lt; 3.1" x="(0 `max` ((width - title_width) / 2))" y="(0 `max` ((height - title_height) / 2))" color="{{wb.text}}"/>
	<title version="&gt;= 3.1" x="(0 `max` ((frame_x_center - title_width / 2) `min` (width - title_width)))" y="(0 `max` ((height - title_height) / 2))" ellipsize_width="width" color="{{wb.text}}"/>
</draw_ops>
<draw_ops name="title_unfocused">
	<title version="&lt; 3.1" x="(0 `max` ((width - title_width) / 2))" y="(0 `max` ((height - title_height) / 2))" color="{{wb.unfocused_text}}"/>
	<title version="&gt;= 3.1" x="(0 `max` ((frame_x_center - title_width / 2) `min` (width - title_width)))" y="(0 `max` ((height - title_height) / 2))" ellipsize_width="width" color="{{wb.unfocused_text}}"/>
</draw_ops>

<draw_ops name="blank">
</draw_ops>

